{
	"schemaVersion": 1,
	"id": "sexmod",
	"version": "${version}",
	"name": "Jenny Mod",
	"description": "Unofficial Fabric 26.3 port of Jenny Mod (Fapcraft) 1.1.0 by Schnurri. Adult content: 18+ only.",
	"authors": [
		"Schnurri (trolmastercard) - original mod"
	],
	"license": "MIT (port code); original assets not included",
	"icon": "logo.png",
